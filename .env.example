# ============================================================
# PitStop — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Settings → Environment Variables.
# ============================================================

# Password único de acceso al historial cloud.
# Cualquiera con esta password puede ver/editar/borrar cotizaciones.
APP_PASSWORD=cambia-esto-por-algo-seguro

# Conexión a Postgres (Neon). Vercel inyecta DATABASE_URL automáticamente
# cuando conectas la integración de Neon desde el Marketplace.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
